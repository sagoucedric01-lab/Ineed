  "info": {
    "title": "API Ineed",
    "description": "API de la marketplace Ineed (Abidjan). Montants en XOF entiers, dates ISO 8601 en UTC, téléphones au format E.164. Les erreurs suivent le format { error: { code, message, details, requestId } }.",
    "version": "0.4.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "07 12 34 56 78",
            "description": "Numéro saisi par l’utilisateur ; le préfixe +225 est ajouté si absent."
          }
        },
        "required": [
          "phone"
        ]
      },
      "OtpChallengeDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "resendAvailableAt": {
            "type": "string",
            "format": "date-time"
          },
          "devMode": {
            "type": "boolean",
            "description": "Vrai si aucun SMS n’est réellement envoyé (mode développement)."
          }
        },
        "required": [
          "challengeId",
          "expiresAt",
          "resendAvailableAt",
          "devMode"
        ]
      },
