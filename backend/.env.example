# Configuration locale de l'API et du worker Ineed.
# Copier en `.env` (jamais commité) : cp .env.example .env
# Les valeurs ci-dessous correspondent aux services de infra/docker-compose.yml.

NODE_ENV=development
# local | test | staging | production  (production interdit les simulateurs OTP et paiement)
APP_ENV=local
PORT=3000
LOG_LEVEL=info
# Origines autorisées pour l'admin web (séparées par des virgules)
CORS_ORIGINS=http://localhost:3001

DATABASE_URL=postgresql://ineed:ineed@localhost:5432/ineed_dev
# Base temporaire utilisée par `pnpm migrate:check-drift` (vide, détruite et recréée par Prisma)
SHADOW_DATABASE_URL=postgresql://ineed:ineed@localhost:5432/ineed_shadow
REDIS_URL=redis://localhost:6379

# Stockage S3-compatible (SeaweedFS en local, fournisseur S3 en production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=ineed-dev-access
S3_SECRET_ACCESS_KEY=ineed-dev-secret-change-me
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=ineed-public
S3_BUCKET_PRIVATE=ineed-private

# Fournisseurs. Les simulateurs sont refusés quand APP_ENV=production.
# dev_console : le code SMS n'est PAS envoyé, il est écrit dans les journaux du serveur.
OTP_PROVIDER=dev_console
# Pour envoyer de vrais SMS (OTP_PROVIDER=twilio_verify) :
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# dev_log : notifications push NON envoyées (écrites dans les journaux), interdit en production.
PUSH_PROVIDER=dev_log
# Pour de vraies notifications (PUSH_PROVIDER=fcm) : compte de service Firebase (JSON encodé en base64), jamais commité.
# FCM_SERVICE_ACCOUNT_B64=
# sandbox : paiements SIMULÉS (aucun argent réel), interdit en production.
PAYMENT_PROVIDER=sandbox
# Adresse publique de l'API (notifications du prestataire, page de paiement simulée).
# PUBLIC_API_URL=http://localhost:3000
# Pour encaisser réellement (PAYMENT_PROVIDER=cinetpay) — clés du compte marchand, jamais commitées :
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=
# PAYMENT_RETURN_URL=https://ineed.ci/paiement/retour

# Secrets : à générer, jamais à copier d'un autre environnement ni à commiter.
#   node ../tools/generate-dev-secrets.mjs --write .env
JWT_PRIVATE_KEY_B64=
DATA_ENCRYPTION_KEY_B64=
OTP_PEPPER=
