  @@unique([senderId, clientMsgId])
  @@index([conversationId, createdAt], map: "messages_conversation_idx")
  @@map("messages")
}

model MissionReportFile {
  reportId String        @map("report_id") @db.Uuid
  fileId   String        @map("file_id") @db.Uuid
  file     File          @relation(fields: [fileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  report   MissionReport @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([reportId, fileId])
  @@map("mission_report_files")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
