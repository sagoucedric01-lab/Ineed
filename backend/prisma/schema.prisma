  offerTtlS         Int              @map("offer_ttl_s")
  reservationTtlS   Int              @map("reservation_ttl_s")
  clientConfirmTtlS Int              @map("client_confirm_ttl_s")
  maxOffersShown    Int              @default(5) @map("max_offers_shown")
  isActive          Boolean          @default(true) @map("is_active")
  updatedBy         String?          @map("updated_by") @db.Uuid
  updatedAt         DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  category          Category?        @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  city              City?            @relation(fields: [cityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service           Service?         @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedByUser     User?            @relation(fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("dispatch_rules")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model File {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId           String?                @map("owner_user_id") @db.Uuid
  purpose               String
  visibility            FileVisibility         @default(PRIVATE)
  bucket                String
  objectKey             String                 @map("object_key")
  mimeType              String                 @map("mime_type")
  sizeBytes             BigInt                 @map("size_bytes")
  sha256                String?
  status                FileStatus             @default(PENDING_UPLOAD)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(6)
  complaintMessages     ComplaintMessage[]
  ownerUser             User?                  @relation("files_owner_user_idTousers", fields: [ownerUserId], references: [id], onUpdate: NoAction)
  messages              Message[]
  missionReportFiles    MissionReportFile[]
  requestMedia          RequestMedia[]
  users                 User[]                 @relation("users_avatar_file_idTofiles")
  verificationDocuments VerificationDocument[]

  @@unique([bucket, objectKey])
  @@map("files")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model IdempotencyKey {
  userId       String    @map("user_id") @db.Uuid
  key          String
  method       String
  path         String
  requestHash  String    @map("request_hash")
  statusCode   Int?      @map("status_code")
  responseBody Json?     @map("response_body")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, key])
  @@index([createdAt], map: "idempotency_keys_created_idx")
  @@map("idempotency_keys")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model LedgerEntry {
  id            BigInt            @id @default(autoincrement())
  transactionId String            @map("transaction_id") @db.Uuid
  account       String
  proId         String?           @map("pro_id") @db.Uuid
  amountXof     BigInt            @map("amount_xof")
  pro           ProProfile?       @relation(fields: [proId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([proId], map: "ledger_entries_pro_idx", where: raw("(pro_id IS NOT NULL)"))
  @@map("ledger_entries")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model LedgerTransaction {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          String
  paymentId     String?       @map("payment_id") @db.Uuid
  refundId      String?       @map("refund_id") @db.Uuid
  payoutId      String?       @map("payout_id") @db.Uuid
  missionId     String?       @map("mission_id") @db.Uuid
  description   String?
  createdBy     String?       @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  ledgerEntries LedgerEntry[]
  createdByUser User?         @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mission       Mission?      @relation(fields: [missionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payout        Payout?       @relation(fields: [payoutId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refund        Refund?       @relation(fields: [refundId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("ledger_transactions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model LocationPing {
  id           BigInt                   @id @default(autoincrement())
  missionId    String                   @map("mission_id") @db.Uuid
  userId       String                   @map("user_id") @db.Uuid
  location     Unsupported("geography")
  accuracyM    Float?                   @map("accuracy_m") @db.Real
  recordedAt   DateTime                 @map("recorded_at") @db.Timestamptz(6)
  receivedAt   DateTime                 @default(now()) @map("received_at") @db.Timestamptz(6)
  isSuspicious Boolean                  @default(false) @map("is_suspicious")
  mission      Mission                  @relation(fields: [missionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         User                     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([missionId, userId, recordedAt], map: "location_pings_dedupe_uq")
  @@index([missionId, receivedAt(sort: Desc)], map: "location_pings_mission_idx")
  @@map("location_pings")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String?
  fileId         String?      @map("file_id") @db.Uuid
  clientMsgId    String       @map("client_msg_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  hiddenAt       DateTime?    @map("hidden_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
