generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["postgresqlExtensions", "partialIndexes"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pgcrypto, postgis]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AbuseReport {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId    String       @map("reporter_id") @db.Uuid
  targetType    ReportTarget @map("target_type")
  targetId      String       @map("target_id") @db.Uuid
  reason        String
  details       String?
  status        ReportStatus @default(OPEN)
  handledBy     String?      @map("handled_by") @db.Uuid
  handledAt     DateTime?    @map("handled_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  handledByUser User?        @relation("abuse_reports_handled_byTousers", fields: [handledBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reporter      User         @relation("abuse_reports_reporter_idTousers", fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([reporterId, targetType, targetId])
  @@map("abuse_reports")
}

model Address {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  label           String?
  cityId          String                   @map("city_id") @db.Uuid
  zoneId          String?                  @map("zone_id") @db.Uuid
  location        Unsupported("geography")
  street          String?
  landmark        String?
  instructions    String?
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(6)
  city            City                     @relation(fields: [cityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zone            Zone?                    @relation(fields: [zoneId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  serviceRequests ServiceRequest[]

  @@index([userId], map: "addresses_user_idx", where: raw("(deleted_at IS NULL)"))
  @@map("addresses")
}

model AdminCredential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash")
  totpSecretEnc     Bytes?    @map("totp_secret_enc")
  totpEnabledAt     DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("admin_credentials")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  actorRoles String[] @default([]) @map("actor_roles")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?  @db.Inet
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actorId, createdAt(sort: Desc)], map: "audit_logs_actor_idx")
  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_logs_entity_idx")
  @@map("audit_logs")
}

model Category {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId        String?          @map("parent_id") @db.Uuid
  slug            String           @unique
  name            String
  description     String?
  searchTerms     String[]         @default([]) @map("search_terms")
  iconKey         String           @map("icon_key")
  sortOrder       Int              @default(0) @map("sort_order")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  parent          Category?        @relation("categoriesTocategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        Category[]       @relation("categoriesTocategories")
  commissionRules CommissionRule[]
  dispatchRules   DispatchRule[]
  proCategories   ProCategory[]
  promotions      Promotion[]
  searchHistories SearchHistory[]
  serviceRequests ServiceRequest[]
  services        Service[]
  skills          Skill[]

  @@map("categories")
}

model City {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode        String                   @map("country_code") @db.Char(2)
  name               String
  timezone           String
  center             Unsupported("geography")
  isActive           Boolean                  @default(false) @map("is_active")
  addresses          Address[]
  countryCodeCountry Country                  @relation(fields: [countryCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  dispatchRules      DispatchRule[]
  proProfiles        ProProfile[]
  referencePrices    ReferencePrice[]
  serviceRequests    ServiceRequest[]
  users              User[]
  zones              Zone[]

  @@unique([countryCode, name])
  @@map("cities")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CommissionRule {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId         String?      @map("category_id") @db.Uuid
  rateBps            Int          @map("rate_bps")
  minXof             BigInt       @default(0) @map("min_xof")
  appliesToTravelFee Boolean      @default(false) @map("applies_to_travel_fee")
  validFrom          DateTime     @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo            DateTime?    @map("valid_to") @db.Timestamptz(6)
  createdBy          String?      @map("created_by") @db.Uuid
  category           Category?    @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUser      User?        @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  commissions        Commission[]

  @@map("commission_rules")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Commission {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  missionId String          @map("mission_id") @db.Uuid
  paymentId String          @unique @map("payment_id") @db.Uuid
  ruleId    String?         @map("rule_id") @db.Uuid
  baseXof   BigInt          @map("base_xof")
  rateBps   Int             @map("rate_bps")
  amountXof BigInt          @map("amount_xof")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  mission   Mission         @relation(fields: [missionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment   Payment         @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rule      CommissionRule? @relation(fields: [ruleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("commissions")
}

model ComplaintMessage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId String    @map("complaint_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  body        String
  isInternal  Boolean   @default(false) @map("is_internal")
  fileId      String?   @map("file_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  author      User      @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file        File?     @relation(fields: [fileId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("complaint_messages")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Complaint {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference         String             @unique
  missionId         String?            @map("mission_id") @db.Uuid
  openedBy          String             @map("opened_by") @db.Uuid
  category          String
  description       String
  status            ComplaintStatus    @default(OPEN)
  assignedTo        String?            @map("assigned_to") @db.Uuid
  resolution        String?
  refundId          String?            @map("refund_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime?          @map("resolved_at") @db.Timestamptz(6)
  complaintMessages ComplaintMessage[]
  assignedToUser    User?              @relation("complaints_assigned_toTousers", fields: [assignedTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mission           Mission?           @relation(fields: [missionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  openedByUser      User               @relation("complaints_opened_byTousers", fields: [openedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refund            Refund?            @relation(fields: [refundId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("complaints")
}

model ConversationRead {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  lastReadAt     DateTime     @map("last_read_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([conversationId, userId])
  @@map("conversation_reads")
}

model Conversation {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId         String             @map("request_id") @db.Uuid
  clientId          String             @map("client_id") @db.Uuid
  proId             String             @map("pro_id") @db.Uuid
  missionId         String?            @map("mission_id") @db.Uuid
  isLocked          Boolean            @default(false) @map("is_locked")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  conversationReads ConversationRead[]
  client            User               @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mission           Mission?           @relation(fields: [missionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pro               ProProfile         @relation(fields: [proId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  request           ServiceRequest     @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages          Message[]

  @@unique([requestId, proId])
  @@map("conversations")
}

model Country {
  code        String  @id @db.Char(2)
  name        String
  currency    String  @db.Char(3)
  phonePrefix String  @map("phone_prefix")
  isActive    Boolean @default(false) @map("is_active")
  cities      City[]

  @@map("countries")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Device {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  app        AppKind
  platform   String
  pushToken  String    @unique @map("push_token")
  appVersion String?   @map("app_version")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("devices")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model DispatchRule {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId            String?          @map("city_id") @db.Uuid
  categoryId        String?          @map("category_id") @db.Uuid
  serviceId         String?          @map("service_id") @db.Uuid
  mode              RequestMode
  strategy          DispatchStrategy
