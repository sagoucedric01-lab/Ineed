/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Mission {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference              String                 @unique
  requestId              String                 @unique(map: "missions_one_active_per_request_uq", where: raw("(status <> 'CANCELLED'::mission_status)")) @map("request_id") @db.Uuid
  offerId                String?                @map("offer_id") @db.Uuid
  clientId               String                 @map("client_id") @db.Uuid
  proId                  String                 @map("pro_id") @db.Uuid
  pricingModel           PricingModel           @map("pricing_model")
  status                 MissionStatus
  scheduledStartAt       DateTime?              @map("scheduled_start_at") @db.Timestamptz(6)
  confirmedAt            DateTime?              @map("confirmed_at") @db.Timestamptz(6)
  enRouteAt              DateTime?              @map("en_route_at") @db.Timestamptz(6)
  arrivedAt              DateTime?              @map("arrived_at") @db.Timestamptz(6)
  startedAt              DateTime?              @map("started_at") @db.Timestamptz(6)
  workCompletedAt        DateTime?              @map("work_completed_at") @db.Timestamptz(6)
  closedAt               DateTime?              @map("closed_at") @db.Timestamptz(6)
  autoCloseAt            DateTime?              @map("auto_close_at") @db.Timestamptz(6)
  cancelledAt            DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy            String?                @map("cancelled_by") @db.Uuid
  cancelReason           String?                @map("cancel_reason")
  disputedAt             DateTime?              @map("disputed_at") @db.Timestamptz(6)
  version                Int                    @default(0)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  commissions            Commission[]
  complaints             Complaint[]
  conversations          Conversation[]
  ledgerTransactions     LedgerTransaction[]
  locationPings          LocationPing[]
  missionReports         MissionReport[]
  missionStatusHistories MissionStatusHistory[]
  cancelledByUser        User?                  @relation("missions_cancelled_byTousers", fields: [cancelledBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
