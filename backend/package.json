{
  "name": "@ineed/backend",
  "version": "0.3.0",
  "private": true,
  "description": "API et worker Ineed (NestJS, PostgreSQL/PostGIS, Redis)",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "dev": "node scripts/dev.mjs main",
    "dev:worker": "node scripts/dev.mjs worker",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "migrate:status": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate status",
    "migrate:check-drift": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "seed": "tsx --env-file-if-exists=.env prisma/seed/run.ts",
    "seed:demo": "tsx --env-file-if-exists=.env prisma/seed/run.ts --demo",
    "openapi:export": "pnpm build && node dist/cli/export-openapi.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "buckets:ensure": "node --env-file-if-exists=.env dist/cli/ensure-buckets.js",
    "admin:bootstrap": "node --env-file-if-exists=.env dist/cli/admin-bootstrap.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.3.15",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "file-type": "22.2.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.15",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
