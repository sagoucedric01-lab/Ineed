  "contrast": {
    "$description": "Paires texte/fond vérifiées par scripts/check-contrast.mjs. 4.5 = WCAG AA texte normal ; 3 = éléments graphiques et texte >= 18,66 px gras.",
    "pairs": [
      ["text", "background", 4.5],
      ["text", "surface", 4.5],
      ["text", "surfaceMuted", 4.5],
      ["textMuted", "surface", 4.5],
      ["textMuted", "background", 4.5],
      ["textSubtle", "surface", 4.5],
      ["onPrimary", "primary", 4.5],
      ["onAction", "action", 4.5],
      ["onAction", "actionPressed", 4.5],
      ["onActionSoft", "actionSoft", 4.5],
      ["action", "surface", 4.5],
      ["onUrgent", "urgent", 4.5],
      ["onUrgentSoft", "urgentSoft", 4.5],
      ["onSuccess", "success", 4.5],
      ["onSuccessSoft", "successSoft", 4.5],
      ["onDanger", "danger", 4.5],
      ["onDangerSoft", "dangerSoft", 4.5],
      ["danger", "surface", 4.5],
      ["onWarningSoft", "warningSoft", 4.5],
      ["borderStrong", "surface", 1.5],
      ["focus", "surface", 3],
      ["urgent", "surface", 2.2],
      ["rating", "surface", 1.8]
    ]
  },
  "typography": {
    "fontFamilies": {
      "display": ["Plus Jakarta Sans", "Inter", "system-ui", "sans-serif"],
      "body": ["Inter", "system-ui", "Roboto", "Helvetica Neue", "Arial", "sans-serif"]
    },
    "scale": {
      "display":  { "family": "display", "size": 28, "lineHeight": 34, "weight": 800, "letterSpacing": -0.4 },
      "titleL":   { "family": "display", "size": 22, "lineHeight": 28, "weight": 700, "letterSpacing": -0.2 },
      "titleM":   { "family": "display", "size": 18, "lineHeight": 24, "weight": 700, "letterSpacing": 0 },
      "bodyL":    { "family": "body", "size": 16, "lineHeight": 24, "weight": 400, "letterSpacing": 0 },
      "bodyM":    { "family": "body", "size": 14, "lineHeight": 20, "weight": 400, "letterSpacing": 0 },
      "label":    { "family": "body", "size": 14, "lineHeight": 20, "weight": 600, "letterSpacing": 0.1 },
      "button":   { "family": "body", "size": 16, "lineHeight": 20, "weight": 600, "letterSpacing": 0.1 },
      "caption":  { "family": "body", "size": 12, "lineHeight": 16, "weight": 500, "letterSpacing": 0.2 },
      "amount":   { "family": "display", "size": 24, "lineHeight": 30, "weight": 800, "letterSpacing": -0.2 }
    }
  },
  "spacing": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "elevation": {
    "card":  "0 1px 2px rgba(16,24,40,0.06), 0 1px 3px rgba(16,24,40,0.08)",
    "sheet": "0 -4px 16px rgba(16,24,40,0.12)",
    "float": "0 8px 24px rgba(16,24,40,0.16)"
  },
  "sizing": {
    "touchTargetMin": 48,
    "buttonHeight": 52,
    "inputHeight": 52,
    "iconSm": 20,
    "iconMd": 24,
    "avatarMd": 48,
    "avatarLg": 72,
    "screenGutter": 16
  },
  "motion": {
    "fast": 120,
    "base": 200,
    "slow": 320,
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  }
